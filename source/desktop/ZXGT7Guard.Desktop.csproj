<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
  <AssemblyName>ZXG T7 DivinX</AssemblyName><RootNamespace>ZXGT7Guard</RootNamespace><Version>1.0.0</Version><ApplicationIcon>..\assets\branding\divinx.ico</ApplicationIcon>
 <Company>STARZISMIK</Company><Authors>STARZISMIK</Authors><Product>[ZXG] T7 DivinX</Product><Description>Lanceur T7 DivinX personnalisé par STARZISMIK</Description><Copyright>Copyright © 2026 STARZISMIK — personnalisation et contributions. Composants tiers : droits de leurs auteurs respectifs.</Copyright></PropertyGroup>
<PropertyGroup>
  <PublishSingleFile>true</PublishSingleFile>
  <SelfContained>true</SelfContained>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  <DebugType>none</DebugType>
  <DebugSymbols>false</DebugSymbols>
</PropertyGroup>
<ItemGroup><Content Include="..\payload\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Resource Include="..\assets\branding\divinx.ico" Link="Assets\divinx.ico"/><Resource Include="..\assets\branding\reference.png" Link="Assets\reference.png"/><Resource Include="..\assets\branding\divinx-hero.png" Link="Assets\divinx-hero.png"/></ItemGroup></Project>

