<Window x:Class="ZXGT7Guard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="[ZXG] T7 DivinX" Icon="/ZXG T7 DivinX;component/Assets/divinx.ico" Width="1360" Height="900" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="Frame" TargetType="Border"><Setter Property="BorderBrush" Value="#168DD4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0C1A24"/><GradientStop Color="#070F16" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style>
  <Style x:Key="FrameTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#279DFA"/><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="19"/><Setter Property="Margin" Value="17,8"/></Style>
  <Style x:Key="TopNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="BorderBrush" Value="#165E8E"/><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="8,13"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Background" Value="#0079FF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3CB5FF"/></Trigger></Style.Triggers></Style>
  <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Background" Value="#0C2332"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#07111B"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="BorderBrush" Value="#779FB9"/><Setter Property="Padding" Value="12,6"/><Setter Property="CaretBrush" Value="#42B3FF"/><Setter Property="FontSize" Value="17"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#07111B"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="BorderBrush" Value="#779FB9"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="17"/></Style>
 </Window.Resources>
 <Grid>
 <Border x:Name="ApplicationContent" BorderBrush="#1E435A" BorderThickness="1" Background="{StaticResource Bg}"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="#235B7E" BorderThickness="0,0,0,1" Background="Transparent">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36*"/><ColumnDefinition Width="64*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#0089FF" BorderThickness="7,0,0,0"><TextBlock VerticalAlignment="Center" Margin="18,0,0,0" FontFamily="Bahnschrift"><Run Text="[ZXG] T7 DivinX" FontWeight="Bold" FontSize="31" Foreground="#C6DDF3"/><Run Text="   par STARZISMIK" FontFamily="Segoe UI" FontSize="11" Foreground="#64A0C8" BaselineAlignment="Baseline"/></TextBlock></Border>
    <Grid Grid.Column="1" Margin="0,9,7,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="114"/></Grid.ColumnDefinitions>
     <UniformGrid Columns="4" WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="OverviewNav" Content="Accueil" Tag="active" Style="{StaticResource TopNav}" Click="Overview_Click"/><Button x:Name="ModulesNav" Content="Modules" Style="{StaticResource TopNav}" Click="Modules_Click"/><Button x:Name="LogsNav" Content="Journal" Style="{StaticResource TopNav}" Click="Logs_Click"/><Button x:Name="InfoNav" Content="Infos" Style="{StaticResource TopNav}" Click="Info_Click"/></UniformGrid>
     <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Padding="0,5" Background="Transparent" BorderThickness="0" Click="Minimize_Click" ToolTip="Réduire"/><Button Content="□" Padding="0,5" Background="Transparent" BorderThickness="0" Click="Maximize_Click" ToolTip="Agrandir / restaurer"/><Button Content="✕" Padding="0,5" Background="Transparent" BorderThickness="0" Click="CloseApp_Click" ToolTip="Fermer l’application"/></UniformGrid>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="36*"/><ColumnDefinition Width="64*"/></Grid.ColumnDefinitions>
   <Border x:Name="HeroPanel" BorderBrush="#255775" BorderThickness="0,0,1,0" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="/ZXG T7 DivinX;component/Assets/divinx-hero.png" Viewbox="0,0,1,1" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background></Border>
   <Grid Grid.Column="1">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="23,18,23,16"><StackPanel>
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PRÉPARER LA SESSION" Foreground="#77BEFF" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="27"/><Border Grid.Column="1" Height="1" Background="#168DD4" Margin="15,0"/><TextBlock Grid.Column="2" Text="///  BLACK OPS III" FontFamily="Bahnschrift" Foreground="#577E9C" FontSize="10" VerticalAlignment="Center"/></Grid>
     <Border x:Name="SessionSettings" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Frame}"><StackPanel><TextBlock Text="●  PROFIL" Style="{StaticResource FrameTitle}"/><Border Background="#17425C" Height="1"/><StackPanel Margin="17,10,17,10"><TextBlock Text="Pseudo" Foreground="#A9C4D9" Margin="0,0,0,6"/><TextBox x:Name="NameInput" MaxLength="15" ToolTip="1 à 15 caractères ASCII"/><TextBlock x:Name="CurrentNameValue" Text="Pseudo du jeu : en attente" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,7"/><WrapPanel><Button Content="Appliquer" Style="{StaticResource SmallAction}" Click="ApplyName_Click"/><Button Content="Restaurer" Style="{StaticResource SmallAction}" Click="RestoreName_Click"/></WrapPanel></StackPanel></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Frame}"><StackPanel><TextBlock Text="▣  SESSION PRIVÉE" Style="{StaticResource FrameTitle}"/><Border Background="#17425C" Height="1"/><StackPanel Margin="17,10,17,10"><TextBlock Text="Mot de passe de session" Foreground="#A9C4D9" Margin="0,0,0,6"/><PasswordBox x:Name="NetworkPassword" MaxLength="64"/><TextBlock Text="Même mot de passe pour les participants" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><DockPanel Margin="0,6,0,0"><CheckBox x:Name="PrivateSession" Content="Session privée" Margin="0,0,9,0" FontSize="12"/><WrapPanel HorizontalAlignment="Right"><Button Content="Appliquer" Style="{StaticResource SmallAction}" Click="ApplyPassword_Click"/><Button Content="Effacer" Style="{StaticResource SmallAction}" Click="ClearPassword_Click"/></WrapPanel></DockPanel></StackPanel></StackPanel></Border>
     </Grid></Border>
     <Border Style="{StaticResource Frame}" Margin="0,0,0,12"><StackPanel><TextBlock Text="◆  MODULE" Style="{StaticResource FrameTitle}"/><Border Background="#17425C" Height="1"/><Grid Margin="17,11"><ComboBox x:Name="RuntimeMode" SelectedIndex="0" SelectionChanged="RuntimeMode_Changed"><ComboBoxItem Content="T7 DivinX — Menu unifié"/><ComboBoxItem Content="T7 DivinX — Divinium / Marché noir"/></ComboBox><Border x:Name="QolHelp" Visibility="Collapsed" IsHitTestVisible="False"/></Grid></StackPanel></Border>
     <Border Style="{StaticResource Frame}" Margin="0,0,0,12"><StackPanel><TextBlock Text="▶  DÉMARRAGE" Style="{StaticResource FrameTitle}"/><Border Background="#17425C" Height="1"/><StackPanel Margin="17,10,17,11">
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="AutoLoad" Content="Chargement automatique" IsChecked="False" Margin="0,3"/><CheckBox x:Name="MinimizeAfterLoad" Content="Réduire après chargement" IsChecked="False" Margin="0,4"/></StackPanel><Border Grid.Column="1" Background="#164965" Margin="3"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Raccourci clavier" Foreground="#A9C4D9" VerticalAlignment="Center" Margin="12,0"/><ComboBox x:Name="MenuKeyInput" Width="74" SelectedIndex="0" SelectionChanged="MenuKey_Changed"><ComboBoxItem Content="F5"/><ComboBoxItem Content="F6"/><ComboBoxItem Content="F7"/><ComboBoxItem Content="F8"/></ComboBox></StackPanel></Grid>
      <ProgressBar x:Name="BusyBar" Height="2" Visibility="Collapsed" IsIndeterminate="True" Foreground="#29B8FF" Margin="0,0,0,5"/>
      <Border Height="1" Background="#17425C" Margin="-17,2,-17,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid VerticalAlignment="Center" Margin="0,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="#628DA7" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="OperationValue" Grid.Column="1" Text="En attente du jeu." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid>
       <Button x:Name="PrimaryAction" Grid.Column="1" Click="Primary_Click" HorizontalAlignment="Stretch" Height="44" Padding="12,5" FontFamily="Bahnschrift" FontSize="17" FontWeight="Bold" Foreground="#001529" BorderBrush="#32ABFF">
        <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0071FF"/><GradientStop Color="#0089FF" Offset="1"/></LinearGradientBrush></Button.Background>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PrimaryActionLabel" Text="Lancer BO3" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel>
       </Button>
      </Grid>
      <TextBlock x:Name="SettingsMessage" Text="" Foreground="#F4CE87" FontSize="11" Margin="0,5,0,0"/>

     </StackPanel></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Frame}"><StackPanel><TextBlock Text="ϟ  STATUT" Style="{StaticResource FrameTitle}"/><Border Background="#17425C" Height="1"/><StackPanel Margin="15,10"><TextBlock x:Name="GameState" Text="Jeu fermé" FontSize="12"/><TextBlock x:Name="MenuValue" Text="Menu non chargé" FontSize="12" Foreground="#52B7FF" Margin="0,4,0,0"/><TextBlock x:Name="NetworkValue" Text="Session en attente" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="IPC : " FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IpcValue" Text="En attente" FontSize="10"/><TextBlock Text=" · Protection : " FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ProtectionValue" Text="En attente" FontSize="10"/></StackPanel><WrapPanel Margin="0,9,0,0"><Button Content="Actualiser" Click="Refresh_Click" Style="{StaticResource SmallAction}"/><Button x:Name="StopAction" Content="Fermer BO3" Click="Stop_Click" Style="{StaticResource SmallAction}" IsEnabled="False"/></WrapPanel></StackPanel></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Frame}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="▤  JOURNAL" Style="{StaticResource FrameTitle}"/><Border Grid.Row="1" Background="#17425C"/><ListBox Grid.Row="2" ItemsSource="{Binding ElementName=ActivityList, Path=Items}" Margin="12,8" Height="110" Background="Transparent" BorderThickness="0" Foreground="#9BB7CC" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid></Border>
     </Grid>
    </StackPanel></ScrollViewer>
<ScrollViewer x:Name="ModulesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20"><StackPanel>
<TextBlock Text="Modules" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Menu complet" FontSize="22" Foreground="#45B8FC"/><TextBlock Text="Accès aux onglets Compte, Zombies, Multijoueur, Marché noir et aux autres outils du menu." Margin="0,12,0,0"/><TextBlock Text="F5 ouvre et ferme le menu par défaut." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Divinium / Marché noir" FontSize="22" Foreground="#45B8FC"/><TextBlock Text="Menu dédié au solde Liquid Divinium, à la quantité souhaitée et aux actions de farm et de dépense." Margin="0,12,0,0"/><TextBlock Text="Choisissez le module depuis Accueil avant son chargement. Redémarrez BO3 pour changer de module." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Session et protections intégrées" FontSize="18"/><TextBlock Text="Préparez le pseudo et le mot de passe avant de lancer BO3. Ces réglages, cinq filtres défensifs et trois blocages issus de T7 Patch sont intégrés dans la même DLL que le menu. Les protections restent partielles." Margin="0,12,0,0"/><TextBlock Text="Le mot de passe reste en mémoire et les participants doivent utiliser la même valeur. Effacez-le avant de rejoindre le matchmaking public." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>

<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Diagnostic" FontSize="20"/><TextBlock x:Name="ProcessValue"/><TextBlock x:Name="BuildValue"/><TextBlock x:Name="PathValue"/><TextBlock x:Name="RuntimeVersion"/><TextBlock x:Name="ProtectionDetail"/><TextBlock x:Name="MenuDetail"/><WrapPanel Margin="0,12,0,0"><Button Content="Ouvrir le menu" Click="OpenMenu_Click" Margin="0,0,8,0"/><Button Content="Fermer le menu" Click="CloseMenu_Click"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer x:Name="InfoPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20"><StackPanel>
<TextBlock Text="À propos" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="[ZXG] T7 DivinX" FontSize="26" Foreground="#45B8FC" TextAlignment="Center"/><TextBlock Text="Version 1.0.0" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="par STARZISMIK" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Crédits d’origine" FontSize="18"/><TextBlock Text="Base du menu : Scroptss / Scropts-QOL. Contributions : Serious, InsaneCallum et contributeurs amont. Bibliothèques : Dear ImGui, MinHook et Detours." Margin="0,12,0,0"/><TextBlock Text="Fonctions de session : adaptations des travaux T7Patch de shiversoftdev et Scroptss. Les attributions et les références sont conservées avec la distribution." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="Protections issues de T7 Patch" FontSize="20" Foreground="#45B8FC"/>
<TextBlock Text="Intégration partielle" FontWeight="SemiBold" Margin="0,10,0,0"/>
<TextBlock Text="Le module intègre des mécanismes défensifs adaptés de T7Patch, issus des travaux de shiversoftdev et Scroptss : contrôle des types de lobby, normalisation du type NAT, limitation du nombre de joueurs annoncé et filtrage de certaines chaînes de configuration hors campagne." Margin="0,12,0,0"/>
<TextBlock Text="Blocages supplémentaires : exécution des commandes Lua par le point dédié, navigateur intégré au jeu et abonnements Workshop automatiques. Installez manuellement les cartes Workshop nécessaires depuis Steam." Margin="0,10,0,0"/>
<TextBlock Text="Le mot de passe de session utilise également un mécanisme réseau adapté de T7Patch. Les participants doivent utiliser la même valeur." Margin="0,10,0,0"/>
<TextBlock Text="Ces protections ne couvrent pas toutes celles de T7 Patch et ne constituent pas un remplacement complet. Leur activation dépend du chargement du module et de la validation des signatures du jeu ; consultez le diagnostic dans Modules pour connaître son état." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
</StackPanel></Border></StackPanel></ScrollViewer>
<Grid x:Name="LogsPage" Visibility="Collapsed" Margin="20" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Journal de l application" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="LogPathValue" Grid.Row="1" Text="Journal local" Foreground="{StaticResource Muted}" Margin="0,12,0,18" /><ListBox x:Name="ActivityList" Grid.Row="2" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Stroke}" FontFamily="Consolas" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Auto" /></Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#235B7E" BorderThickness="0,1,0,0" Padding="24,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Version 1.0.0" FontFamily="Bahnschrift" FontSize="11" Foreground="#557F9C"/><Border Grid.Column="1" Height="1" Background="#194565" Margin="25,0"/><TextBlock Grid.Column="2" Text="par STARZISMIK" FontFamily="Bahnschrift" FontSize="11" Foreground="#7A9FB9"/></Grid></Border>
 </Grid></Border>
 <Grid x:Name="UpdateOverlay" Visibility="Collapsed" Background="#A6070B10" Panel.ZIndex="100" WindowChrome.IsHitTestVisibleInChrome="True">
  <Border Width="580" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#0B1822" BorderBrush="#00BFFF" BorderThickness="1" Padding="36">
   <StackPanel>
    <TextBlock Text="[ZXG] T7 DivinX" Foreground="#62C9FF" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
    <TextBlock x:Name="UpdateTitle" Text="MISE À JOUR DISPONIBLE" Foreground="White" FontSize="27" FontWeight="Bold" TextAlignment="Center" Margin="0,26,0,18"/>
    <TextBlock x:Name="UpdateSummary" Text="Une nouvelle version est disponible." Foreground="#E8F3FC" FontSize="17" TextAlignment="Center"/>
    <TextBlock x:Name="UpdateDetails" Text="Cette version ne peut plus être utilisée. Téléchargez et installez la dernière version pour continuer." Foreground="#ADC0D0" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,24"/>
    <Border Background="#102B3D" Padding="14" Margin="0,0,0,24"><TextBlock x:Name="UpdateVersions" Text="Version installée : 1.0.0" Foreground="#72BDE9" TextAlignment="Center"/></Border>
    <Button x:Name="UpdateDownloadButton" Content="Télécharger la nouvelle version" Click="UpdateDownload_Click" Background="#008FFF" Foreground="White" FontSize="16" FontWeight="SemiBold" Padding="18,14"/>
    <Button Content="Quitter l’application" Click="CloseApp_Click" Background="Transparent" BorderBrush="#315268" Foreground="#CBDCE9" Padding="18,10" Margin="0,12,0,0"/>
    <Button x:Name="UpdateRetryButton" Content="Réessayer" Click="UpdateRetry_Click" Visibility="Collapsed" Padding="18,14"/><TextBlock x:Name="UpdateNotice" Text="" Visibility="Collapsed" Foreground="#7895A9" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
 </Grid>
</Window>